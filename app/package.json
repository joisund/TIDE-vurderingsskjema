{
  "name": "tide-kjorevurdering",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": { "node": "26.13.0", "npm": "11.20.0" },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "vite",
    "dev:pilot": "vite --mode pilot",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pilot:start": "node server/pilot-server.ts",
    "pilot:seed": "node server/pilot-admin.ts seed",
    "pilot:mailbox": "node server/pilot-admin.ts mailbox",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
